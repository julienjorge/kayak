# Contact technique envoyé dans le User-Agent des requêtes Nominatim
CONTACT_EMAIL=

# Clé API OpenWeather (One Call 3.0)
OWM_API_KEY=

# Scraping Booking.com — contournement du challenge AWS WAF
# Relever dans un navigateur ayant chargé booking.com :
#   BOOKING_USER_AGENT : console DevTools -> navigator.userAgent
#   BOOKING_WAF_TOKEN  : DevTools -> Application -> Cookies -> aws-waf-token
# Le jeton est périssable : à renouveler quand le scraping renvoie un statut 202.
BOOKING_USER_AGENT=
BOOKING_WAF_TOKEN=

# Stockage S3 — data lake du projet
# AWS_REGION : région du bucket, fixée à sa création et non modifiable ensuite.
#              Doit être identique à celle affichée dans la console S3.
# S3_BUCKET  : nom du bucket, unique sur l'ensemble d'AWS.
AWS_REGION=
S3_BUCKET=

# Identifiants de l'utilisateur IAM disposant des droits S3
# Console AWS -> IAM -> Users -> <utilisateur> -> Security credentials -> Create access key
# La clé secrète n'est affichée qu'une seule fois, à la création.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=